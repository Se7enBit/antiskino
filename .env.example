# Copy to .env (gitignored) and fill in. Never commit real values.

# --- App (public: embedded in the app bundle) --------------------------------
# Supabase project URL, e.g. https://<project-ref>.supabase.co (local: http://127.0.0.1:54321)
EXPO_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Never the secret / service-role key.
EXPO_PUBLIC_SUPABASE_KEY=
# Public site URL, e.g. https://se7enbit.github.io/antiskino
EXPO_PUBLIC_SITE_URL=

# --- Edge function secrets (`supabase secrets set`, or supabase/functions/.env locally)
# SUPABASE_URL and the secret / service-role key are provided to deployed functions automatically.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
SITE_URL=
# Optional, for Expo push
EXPO_ACCESS_TOKEN=
# Shared with pg_cron: the same value as the Vault secret `notify_secret` (push delivery)
NOTIFY_SECRET=
# From M7 (online payments)
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- CI only (GitHub Actions secrets; not read by the app) ---------------------
# Not used yet: dev migrations go through the Supabase GitHub integration.
# Reserved for the manual production migration workflow (M8).
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=
# Not used until EAS builds (preview APK, M6)
EXPO_TOKEN=
